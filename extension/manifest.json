{
  "manifest_version": 3,
  "name": "Chrome Hop — Open in Chrome",
  "version": "1.1.0",
  "description": "Open the current Firefox tab in Google Chrome with one click. Windows helper required. No tracking or website scripts.",
  "homepage_url": "https://github.com/aspendesign/chrome-hop",
  "permissions": ["activeTab", "nativeMessaging", "menus"],
  "optional_permissions": ["tabs"],
  "background": {"scripts": ["background.js"]},
  "action": {
    "default_title": "Open this tab in Chrome",
    "default_icon": {"16": "icons/hop-16.png", "32": "icons/hop-32.png", "48": "icons/hop-48.png"}
  },
  "icons": {"48": "icons/hop-48.png", "96": "icons/hop-96.png", "128": "icons/hop-128.png"},
  "browser_specific_settings": {
    "gecko": {
      "id": "chrome-hop@aspendesign.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["browsingActivity"]}
    }
  },
  "content_security_policy": {"extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'"}
}
